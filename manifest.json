{
  "manifest_version": 2,
  "name": "Wayback Bulk Save",
  "version": "0.1.0",
  "description": "Saves a list of addresses to the Wayback Machine one at a time from its Save Page Now page. Unofficial; not made by the Internet Archive.",
  "content_scripts": [
    {
      "matches": [
        "https://web.archive.org/save*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wayback-bulk-save@merichar",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "homepage_url": "https://github.com/merichar/wayback-bulk-save"
}
