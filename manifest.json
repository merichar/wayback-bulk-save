{
  "manifest_version": 2,
  "name": "Wayback Bulk Save",
  "version": "0.5.1",
  "description": "Saves a list of web pages to the Wayback Machine, one at a time, with your archive.org account. Unofficial; not made by the Internet Archive.",
  "homepage_url": "https://github.com/merichar/wayback-bulk-save",
  "icons": {
    "48": "icon-98.svg",
    "96": "icon-98.svg"
  },
  "browser_action": {
    "default_icon": "icon-98.svg",
    "default_title": "Wayback Bulk Save"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "https://web.archive.org/*",
    "https://archive.org/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wayback-bulk-save@merichar",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/merichar/wayback-bulk-save/main/updates.json"
    }
  }
}
